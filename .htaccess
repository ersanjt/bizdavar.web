# Bizdavar Group — Apache / cPanel
# https://bizdavar.com

# ── General ────────────────────────────────────────────────────────────────
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Fix Persian/UTF-8 display (e.g. brand pages served as ????)
AddDefaultCharset UTF-8
AddType 'text/html; charset=UTF-8' .html

# Block dotfiles (.git, .env, etc.)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Never serve SQLite / dump files from the web root
<FilesMatch "\.(sqlite|sqlite3|db|sql)$">
  Require all denied
</FilesMatch>

# ── LiteSpeed — never cache HTML (stale page cache blocked GTM/deploy updates)
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Security headers (mod_headers) ───────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

  # script-src has no 'unsafe-inline' — securityheaders.com caps the grade at A when it is present.
  # Page boots live in /assets/scripts/page-boot/. style-src still allows inline CSS.
  Header set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com https://repleo.app https://cdn.socket.io; \
    style-src 'self' 'unsafe-inline'; \
    font-src 'self' data:; \
    img-src 'self' data: https:; \
    media-src 'self' https://assets.mixkit.co; \
    object-src 'none'; \
    frame-src 'self' https://www.googletagmanager.com; \
    connect-src 'self' https://speed.cloudflare.com https://ipapi.co https://ipwho.is https://api.ipify.org https://api6.ipify.org https://www.googleapis.com https://formspree.io https://*.formspree.io https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://analytics.google.com https://cloudflareinsights.com https://*.cloudflareinsights.com https://repleo.app https://socket.repleo.app wss://socket.repleo.app; \
    frame-ancestors 'self'; \
    base-uri 'self'; \
    form-action 'self' mailto: https://formspree.io https://*.formspree.io; \
    upgrade-insecure-requests"

  # Cache static assets in browser (no CSP on images/fonts — breaks SVG <text> in <img>)
  <FilesMatch "\.(css|js)$">
    Header unset Content-Security-Policy
    Header unset Content-Security-Policy-Report-Only
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|gif|ico|woff2?)$">
    Header unset Content-Security-Policy
    Header unset Content-Security-Policy-Report-Only
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# ── llms.txt for AI agents (Lighthouse Agentic Browsing) ───────────────────
<IfModule mod_headers.c>
  <Files "llms.txt">
    Header set Content-Type "text/markdown; charset=utf-8"
  </Files>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Clean URLs + HTTPS (mod_rewrite) ───────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # PHP API & admin — do not rewrite to .html
  RewriteRule ^api/ - [L]
  RewriteRule ^admin/ - [L]

  # www → apex
  RewriteCond %{HTTP_HOST} ^www\.bizdavar\.com [NC]
  RewriteRule ^ https://bizdavar.com%{REQUEST_URI} [R=301,L]

  # HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Shop HTML shares a name with the SKU folder pages/motorcycle/.
  # [END] so the locale .htaccess cannot fall through to the Persian file.
  RewriteRule ^pages/motorcycle/?$ /pages/motorcycle.html [END]
  RewriteRule ^tr/pages/motorcycle/?$ /tr/pages/motorcycle.html [END]
  RewriteRule ^en/pages/motorcycle/?$ /en/pages/motorcycle.html [END]
  RewriteRule ^ru/pages/motorcycle/?$ /ru/pages/motorcycle.html [END]
  RewriteRule ^ar/pages/motorcycle/?$ /ar/pages/motorcycle.html [END]

  # Brand HTML shares a name with the part folder pages/blue-print/.
  RewriteRule ^pages/blue-print/?$ /pages/blue-print.html [END]
  RewriteRule ^tr/pages/blue-print/?$ /tr/pages/blue-print.html [END]
  RewriteRule ^en/pages/blue-print/?$ /en/pages/blue-print.html [END]
  RewriteRule ^ru/pages/blue-print/?$ /ru/pages/blue-print.html [END]
  RewriteRule ^ar/pages/blue-print/?$ /ar/pages/blue-print.html [END]

  # /index.html → / (only when browser requests index.html directly, not locale rewrites)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L,NC]

  # /fa/ prefix → root (Persian is default, no /fa/ in URLs)
  RewriteRule ^fa/?(.*)$ /$1 [R=301,L]

  # Geo language on entry: pick the locale from Cloudflare's CF-IPCountry before any Persian
  # HTML loads, instead of the client-side redirect in i18n.js (same map as GEO_MAP there).
  # Only for visitors arriving from outside the site on an unprefixed page; never for internal
  # navigation (language switcher), crawlers, ?lang=, a saved Persian choice or rewritten sub-requests.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{QUERY_STRING} !(^|&)lang= [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bizdavar\.com [NC]
  RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|google|bing|yandex|baidu|facebookexternalhit|whatsapp|telegram|skype|discord|preview|chatgpt|anthropic|perplexity|cohere|meta-external) [NC]
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)bd_locale=fa(;|$)
  RewriteRule ^(pages/[^.]*(\.html)?)?$ - [E=BD_GEO:1]

  RewriteCond %{ENV:BD_GEO} =1
  RewriteCond %{HTTP_COOKIE} (^|;\s*)bd_locale=(tr|en|ru|ar)(;|$)
  RewriteRule ^(pages/[^.]*(\.html)?)?$ /%2/$1 [R=302,L,E=BD_GEO_REDIR:1]

  RewriteCond %{ENV:BD_GEO} =1
  RewriteCond %{HTTP:CF-IPCountry} ^TR$ [NC]
  RewriteRule ^(pages/[^.]*(\.html)?)?$ /tr/$1 [R=302,L,E=BD_GEO_REDIR:1]

  RewriteCond %{ENV:BD_GEO} =1
  RewriteCond %{HTTP:CF-IPCountry} ^(RU|BY|KZ|KG|AM|AZ)$ [NC]
  RewriteRule ^(pages/[^.]*(\.html)?)?$ /ru/$1 [R=302,L,E=BD_GEO_REDIR:1]

  RewriteCond %{ENV:BD_GEO} =1
  RewriteCond %{HTTP:CF-IPCountry} ^(AE|SA|QA|KW|BH|OM|EG|IQ|JO|LB|SY|YE|LY|MA|DZ|TN|PS|SD)$ [NC]
  RewriteRule ^(pages/[^.]*(\.html)?)?$ /ar/$1 [R=302,L,E=BD_GEO_REDIR:1]

  RewriteCond %{ENV:BD_GEO} =1
  RewriteCond %{HTTP:CF-IPCountry} ^[A-Z]{2}$ [NC]
  RewriteCond %{HTTP:CF-IPCountry} !^(IR|XX|T1)$ [NC]
  RewriteRule ^(pages/[^.]*(\.html)?)?$ /en/$1 [R=302,L,E=BD_GEO_REDIR:1]

  # The geo 302 depends on country, cookie, referer and user agent — a shared cache must never
  # store it, or one visitor's redirect is replayed to Iranian users and crawlers.
  <IfModule mod_headers.c>
    Header always set Cache-Control "private, no-store, max-age=0" env=BD_GEO_REDIR
    Header always set Vary "Cookie, Referer, User-Agent, CF-IPCountry" env=BD_GEO_REDIR
  </IfModule>

  # Short shareable speed test URLs (/speed-test, /speedtest, /en/speed-test, …)
  RewriteRule ^speed-?test/?$ /pages/speed-test [R=301,L,NC]
  RewriteRule ^(tr|en|ru|ar)/speed-?test/?$ /$1/pages/speed-test [R=301,L,NC]
  RewriteRule ^tools/?$ /pages/tools [R=301,L,NC]
  RewriteRule ^my-?ip/?$ /pages/what-is-my-ip [R=301,L,NC]
  RewriteRule ^utm/?$ /pages/utm-builder [R=301,L,NC]

  # Locale homes — prefer baked locale HTML (correct OG/title for crawlers & WhatsApp)
  RewriteCond %{REQUEST_URI} ^/(tr|en|ru|ar)/?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
  RewriteRule ^(tr|en|ru|ar)/?$ $1/index.html [L]

  # Fallback if locale index missing
  RewriteCond %{REQUEST_URI} ^/(tr|en|ru|ar)/?$ [NC]
  RewriteRule ^ /index.html [L]

  # Locale-prefixed URLs — baked copy first, then shared pages/*.html
  # Use $1/$2 (next RewriteRule captures). %1 is empty in this block and was
  # matching the FA file, then rewriting to a missing /en/pages/*.html (404).
  RewriteCond %{DOCUMENT_ROOT}/$1/pages/blog.html -f
  RewriteRule ^(tr|en|ru|ar)/blog/?$ $1/pages/blog.html [L]
  RewriteCond %{DOCUMENT_ROOT}/pages/blog.html -f
  RewriteRule ^(tr|en|ru|ar)/blog/?$ pages/blog.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/pages/$2.html -f
  RewriteRule ^(tr|en|ru|ar)/pages/(.+?)/?$ $1/pages/$2.html [L]
  RewriteRule ^(tr|en|ru|ar)/pages/(.+?)/?$ pages/$2.html [L]

  # /pages/foo/ → /pages/foo (skip locale homes)
  RewriteCond %{REQUEST_URI} !^/(tr|en|ru|ar)/?$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # /blog → /pages/blog (legacy URL — external canonical redirect)
  RewriteCond %{THE_REQUEST} \s/blog[\s?] [NC]
  RewriteRule ^blog/?$ /pages/blog [R=301,L]

  # Legacy typo: fguard → fxguard (old HTML referenced fguard/*.webp)
  RewriteRule ^pages/enpo(?:\.html)?/?$ /pages/pneumatic [R=301,L]
  RewriteRule ^(tr|en|ru|ar)/pages/enpo(?:\.html)?/?$ /$1/pages/pneumatic [R=301,L]
  RewriteRule ^pages/fguard/?$ /pages/fxguard [R=301,L]
  RewriteRule ^assets/images/products/fguard/fguard-hero\.webp$ /assets/images/products/fxguard/fxguard-hero.svg [R=301,L]
  RewriteRule ^assets/images/products/fguard/(.*)$ /assets/images/products/fxguard/$1 [R=301,L]

  # Legacy WordPress / GSC URLs that still get clicks (404 in Search Console)
  RewriteRule ^about-us/?$ /pages/about [R=301,L]
  RewriteRule ^radar-6x/?$ /pages/vega [R=301,L]
  RewriteRule ^prosense-gas-detectors/?$ /pages/prosense [R=301,L]
  RewriteRule ^webstruct/?$ / [R=301,L]

  # Internal serve /blog and /pages/blog without .html
  RewriteRule ^blog/?$ pages/blog.html [L]
  RewriteRule ^pages/blog/?$ pages/blog.html [L]

  # External redirect: *.html → extensionless (preserve query string)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Internal rewrite: /pages/foo → /pages/foo.html (skip locale home paths)
  RewriteCond %{REQUEST_URI} !^/(tr|en|ru|ar)/?$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ── Expires (mod_expires) ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
