Options -Indexes

# Extra lock on /admin — activate by creating .htpasswd in this folder:
#   htpasswd -cB admin/.htpasswd YOUR_USER
# Then set AuthUserFile to the absolute server path if the prompt does not appear.
#
# Optional IP lock (uncomment and use real IPs only):
#   Require ip 203.0.113.10
#
<IfFile .htpasswd>
  AuthType Basic
  AuthName "BizHub"
  AuthUserFile "${DOCUMENT_ROOT}/admin/.htpasswd"
  <RequireAll>
    Require valid-user
  </RequireAll>
</IfFile>
