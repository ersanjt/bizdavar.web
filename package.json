{
  "name": "bizdavar-web",
  "private": true,
  "description": "Bizdavar Group — static multilingual corporate site",
  "scripts": {
    "audit": "node scripts/verify-all.js",
    "audit:assets": "node scripts/audit-assets.js",
    "audit:site": "node scripts/site-audit.js",
    "audit:images": "node scripts/verify-config-images.js",
    "sitemap": "node scripts/gen-sitemap.js",
    "seo": "node scripts/gen-seo-head.js && node scripts/bake-static-seo.js && node scripts/hoist-critical-css.js && node scripts/gen-sitemap.js && node scripts/gen-robots.js",
    "seo-head": "node scripts/gen-seo-head.js",
    "bake-seo": "node scripts/bake-static-seo.js",
    "strip-gtag": "node scripts/strip-standalone-gtag.js",
    "robots": "node scripts/gen-robots.js",
    "css": "node scripts/bundle-css.js",
    "optimize": "node scripts/optimize-html.js",
    "hoist-css": "node scripts/hoist-critical-css.js",
    "brand:icons": "python scripts/generate-brand-icons.py",
    "serve": "npx --yes serve . -l 3456"
  },
  "engines": {
    "node": ">=18"
  }
}
